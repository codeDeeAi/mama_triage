node_modules/
dist/
coverage/
*.log

# Secrets — never commit. Values live in Secret Manager in deployed environments.
.env
.env.local
.env.*.local

# Generated vector index. Rebuilt by `npm run kb:ingest`; shipped inside the Docker
# image at build time (IMPLEMENTATION_PLAN.md section 10.4).
knowledge/index/

# Source guideline PDFs are not redistributable; only the extracted, reviewed Markdown
# is committed. See knowledge/SOURCES.md.
knowledge/sources/*.pdf

# Raw source PDFs: large and redistributable only under their own licences.
# Extraction is repeatable via `npm run kb:extract`; the extracted Markdown is committed.
knowledge/raw/

# Evaluation output is regenerated by `eval/runner.ts`; report figures are produced
# from it rather than committed.
eval/out/

.DS_Store
.idea/
*.swp

IMPLEMENTATION_PLAN.md

# Documentation is tracked.
#
# `docs/` was ignored wholesale at one point and the files that matter were force-added
# past it. That combination is a trap: every *new* doc is silently dropped from commits
# with no error, which is exactly how docs/DEPLOY-COOLIFY.md went missing from the commit
# that introduced it. Ignore only what is genuinely generated.
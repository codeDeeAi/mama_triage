# mama-triage — environment contract
#
# config.ts validates every variable below at boot and exits non-zero if any required
# value is missing or malformed. A triage service must not start half-configured.
#
# Copy to .env for local development. In deployed environments these come from
# GCP Secret Manager, never from a file baked into the image.

# ---- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# ---- database --------------------------------------------------------------
# Host port 5433 — see docker-compose.yml. Cloud SQL uses the standard port.
DATABASE_URL=postgresql://mama:mama@localhost:5433/mama_triage

# ---- messaging channels ----------------------------------------------------
# At least one channel is required. Configure WhatsApp, Telegram, or both — a mother
# chooses her channel at registration. A partially configured channel is rejected at
# boot rather than failing on the first message.

# ---- Telegram Bot API ------------------------------------------------------
# Much the simplest channel to stand up: no business verification, no template approval,
# and free-text two-way messaging. Get a token from @BotFather in about two minutes.
#
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts
#   2. Copy the token into TELEGRAM_BOT_TOKEN
#   3. Invent a random TELEGRAM_WEBHOOK_SECRET (openssl rand -hex 32)
#   4. Register the webhook once the service has a public HTTPS URL:
#      curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#           -H 'Content-Type: application/json' \
#           -d '{"url":"https://YOUR-HOST/telegram/webhook","secret_token":"<SECRET>",
#                "allowed_updates":["message","callback_query"]}'
#
# TELEGRAM_WEBHOOK_SECRET is what authenticates the endpoint — Telegram echoes it in the
# X-Telegram-Bot-Api-Secret-Token header on every update. Without it the webhook is open.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Used to build the t.me deep link shown at registration, e.g. MamaTriageBot
TELEGRAM_BOT_USERNAME=

# ---- WhatsApp Business Cloud API (Meta) ------------------------------------
# WHATSAPP_APP_SECRET is used for X-Hub-Signature-256 verification on every inbound
# webhook. WHATSAPP_VERIFY_TOKEN is a random string you choose; Meta echoes it back
# during the one-time subscription handshake.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Anthropic -------------------------------------------------------------
# ANTHROPIC_MODEL is recorded on every triage_outcomes row so results stay reproducible.
# SAFETY_MODEL runs the independent second-pass check (plan section 11.3).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
SAFETY_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=1500

# ---- RAG -------------------------------------------------------------------
VOYAGE_API_KEY=
# voyage-4-lite carries a free token allowance; voyage-3 is excluded from it.
EMBEDDING_MODEL=voyage-4-lite
CHROMA_PATH=./knowledge/index
RETRIEVAL_TOP_K=5

# ---- privacy ---------------------------------------------------------------
# Phone numbers are never persisted. wa_id_hash = HMAC-SHA256(phone, PHONE_HASH_PEPPER).
# Generate with: openssl rand -hex 32
PHONE_HASH_PEPPER=

# ---- behaviour -------------------------------------------------------------
SESSION_TTL_MINUTES=60
PROMPT_VERSION=triage.v1

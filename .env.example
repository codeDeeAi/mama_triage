# mama-triage — environment contract
#
# config.ts validates every variable below at boot and exits non-zero if any required
# value is missing or malformed. A triage service must not start half-configured.
#
# Copy to .env for local development. In deployed environments these come from
# GCP Secret Manager, never from a file baked into the image.

# ---- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# ---- database --------------------------------------------------------------
# Host port 5433 — see docker-compose.yml. Cloud SQL uses the standard port.
DATABASE_URL=postgresql://mama:mama@localhost:5433/mama_triage

# ---- WhatsApp Business Cloud API (Meta) ------------------------------------
# WHATSAPP_APP_SECRET is used for X-Hub-Signature-256 verification on every inbound
# webhook. WHATSAPP_VERIFY_TOKEN is a random string you choose; Meta echoes it back
# during the one-time subscription handshake.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Anthropic -------------------------------------------------------------
# ANTHROPIC_MODEL is recorded on every triage_outcomes row so results stay reproducible.
# SAFETY_MODEL runs the independent second-pass check (plan section 11.3).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
SAFETY_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=1500

# ---- RAG -------------------------------------------------------------------
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
CHROMA_PATH=./knowledge/index
RETRIEVAL_TOP_K=5

# ---- privacy ---------------------------------------------------------------
# Phone numbers are never persisted. wa_id_hash = HMAC-SHA256(phone, PHONE_HASH_PEPPER).
# Generate with: openssl rand -hex 32
PHONE_HASH_PEPPER=

# ---- behaviour -------------------------------------------------------------
SESSION_TTL_MINUTES=60
PROMPT_VERSION=triage.v1

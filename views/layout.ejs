<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <meta name="description" content="Check danger signs for mothers and newborn babies in the first year after birth. A research prototype." />
  <meta name="theme-color" content="#0b7a5a" />
  <meta name="color-scheme" content="light" />
  <!-- Same-origin assets only: no CDN, which matters for a low-bandwidth audience. -->
  <link rel="stylesheet" href="/assets/styles.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='26' font-size='26'>🤱</text></svg>" />
</head>
<body class="flex min-h-screen flex-col bg-cream text-ink antialiased">

  <a href="#main" class="skip-link">Skip to the main content</a>

  <!--
    The emergency instruction sits above everything, on every page, and stays pinned to
    the top of the viewport. If someone lands here while their baby is in danger, reading
    a description of the service is the wrong thing for them to do next — so this is the
    one element that never scrolls away.
  -->
  <div class="sticky top-0 z-40 border-b border-red-200 bg-red-100/95 backdrop-blur">
    <p class="mx-auto flex max-w-5xl items-center justify-center gap-2 px-5 py-2.5 text-center text-sm leading-snug text-red-900">
      <span aria-hidden="true">🚨</span>
      <span>
        <strong>If this is an emergency, go to your nearest health facility now.</strong>
        <span class="hidden sm:inline">Do not wait for a reply here.</span>
      </span>
    </p>
  </div>

  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4">
      <a href="/" class="flex items-center gap-2.5 rounded-lg focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand/25">
        <span class="text-2xl" aria-hidden="true">🤱</span>
        <span class="text-lg font-bold tracking-tight">MamaTriage</span>
      </a>

      <div class="flex items-center gap-3">
        <span class="badge bg-amber-100 text-amber-800">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
          Research prototype
        </span>
        <a href="/register"
           class="hidden rounded-lg px-3 py-2 text-sm font-semibold text-brand transition hover:bg-brand-light focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand/25 sm:inline-block">
          Register
        </a>
      </div>
    </div>
  </header>

  <main id="main" class="flex-1"><%- body %></main>

  <footer class="mt-16 border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-5 py-10">
      <div class="grid gap-8 sm:grid-cols-[1fr_auto]">
        <div class="space-y-3 text-sm leading-relaxed text-slate-600">
          <p class="font-semibold text-ink">
            MamaTriage is a research prototype. It is not a doctor and does not give diagnoses.
          </p>
          <p>
            Built for the MSc Information Technology programme, MIVA Open University, Abuja.
            Clinical guidance is drawn from WHO IMCI and Federal Ministry of Health Nigeria
            publications. Not a medical device, and not for use in place of care.
          </p>
          <p class="text-slate-500">
            We store an anonymous copy of conversations for research. Phone numbers are never
            saved in readable form.
          </p>
        </div>

        <nav aria-label="Policies" class="sm:text-right">
          <ul class="space-y-2 text-sm">
            <li><a href="/privacy" class="link">Privacy notice</a></li>
            <li><a href="/terms" class="link">Terms of use</a></li>
            <li><a href="/register" class="link">Register</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </footer>

  <script src="/assets/htmx.min.js" defer></script>
  <script>
    /*
     * htmx does not swap a 4xx response by default, so the server-rendered validation
     * errors on /register were being fetched and then dropped on the floor — the form
     * simply did nothing when a field was wrong. 422 is the one status this app uses to
     * mean "here is the same form back, with the problems marked", so it opts in.
     */
    document.body.addEventListener('htmx:beforeSwap', function (evt) {
      if (evt.detail.xhr && evt.detail.xhr.status === 422) {
        evt.detail.shouldSwap = true;
        evt.detail.isError = false;
      }
    });
  </script>
</body>
</html>
